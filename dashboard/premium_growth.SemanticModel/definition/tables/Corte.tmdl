		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: MesNumero

	partition Corte = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(MINX(ALL(Polizas),Polizas[policy_start_date]),MAXX(ALL(Polizas),Polizas[policy_start_date])),"Anio",YEAR([Date]),"MesNumero",MONTH([Date]),"Mes",FORMAT([Date],"mmmm","es-MX"))
