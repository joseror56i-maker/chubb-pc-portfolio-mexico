table Corte
	lineageTag: f3ce0f6e-3108-418a-ab0a-bf4ac5e79222

	column Fecha
		dataType: dateTime
		formatString: dd MMM yyyy
		lineageTag: cb7cc066-8b69-4eac-941d-3454d3a7a70c
		summarizeBy: none
		sourceColumn: [Date]

	column Anio
		dataType: int64
		formatString: 0
		lineageTag: 38d20d13-06ea-4544-8f46-6dafa6a46260
		summarizeBy: none
		sourceColumn: [Anio]

	column MesNumero
		dataType: int64
		isHidden
		lineageTag: 7de178c5-f1ab-4325-a076-46a2587e1065
		summarizeBy: none
		sourceColumn: [MesNumero]

	column Mes
		dataType: string
