	partition Polizas = m
		mode: import
		source =
				let
				    Source = if Text.Trim(ReportingCsvPath) = "" then error "Set ReportingCsvPath to the reporting CSV, or run the repository dashboard setup helper." else Csv.Document(File.Contents(ReportingCsvPath), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"ClientId", type text}, {"policy_id", type text}, {"client_name", type text}, {"state", type text}, {"municipality", type text}, {"coverage_type", type text}, {"industry", type text}, {"premium", Currency.Type}, {"sum_insured", Currency.Type}, {"policy_start_date", type date}, {"policy_end_date", type date}, {"fill_method", type text}, {"confidence_level", type text}}, "en-US")
				in
				    Types
