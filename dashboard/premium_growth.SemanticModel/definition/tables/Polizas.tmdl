	measure Ranking =
			SWITCH(TRUE(),
			ISINSCOPE(Polizas[industry]),
			VAR V=SELECTEDVALUE(Polizas[industry])
			VAR M=[Ranking valor]
			VAR C=TOPN([Top seleccionado],FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[industry]),"@M",[Ranking valor]),NOT ISBLANK([@M])),[@M],DESC,Polizas[industry],ASC)
			RETURN IF(NOT ISBLANK(M) && CONTAINS(C,Polizas[industry],V),1+COUNTROWS(FILTER(C,[@M]>M || ([@M]=M && Polizas[industry]<V)))),
			ISINSCOPE(Polizas[state]),
			VAR V=SELECTEDVALUE(Polizas[state])
			VAR M=[Ranking valor]
			VAR C=TOPN([Top seleccionado],FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[state]),"@M",[Ranking valor]),NOT ISBLANK([@M])),[@M],DESC,Polizas[state],ASC)
			RETURN IF(NOT ISBLANK(M) && CONTAINS(C,Polizas[state],V),1+COUNTROWS(FILTER(C,[@M]>M || ([@M]=M && Polizas[state]<V)))),
			ISINSCOPE(Polizas[municipality]),
			VAR V=SELECTEDVALUE(Polizas[municipality])
			VAR M=[Ranking valor]
			VAR C=TOPN([Top seleccionado],FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[municipality]),"@M",[Ranking valor]),NOT ISBLANK([@M])),[@M],DESC,Polizas[municipality],ASC)
			RETURN IF(NOT ISBLANK(M) && CONTAINS(C,Polizas[municipality],V),1+COUNTROWS(FILTER(C,[@M]>M || ([@M]=M && Polizas[municipality]<V)))),
			ISINSCOPE(Polizas[coverage_type]),
			VAR V=SELECTEDVALUE(Polizas[coverage_type])
			VAR M=[Ranking valor]
			VAR C=TOPN([Top seleccionado],FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[coverage_type]),"@M",[Ranking valor]),NOT ISBLANK([@M])),[@M],DESC,Polizas[coverage_type],ASC)
			RETURN IF(NOT ISBLANK(M) && CONTAINS(C,Polizas[coverage_type],V),1+COUNTROWS(FILTER(C,[@M]>M || ([@M]=M && Polizas[coverage_type]<V)))),
			ISINSCOPE(Polizas[Cliente etiqueta]),
			VAR V=SELECTEDVALUE(Polizas[Cliente etiqueta])
			VAR M=[Ranking valor]
			VAR C=TOPN([Top seleccionado],FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[Cliente etiqueta]),"@M",[Ranking valor]),NOT ISBLANK([@M])),[@M],DESC,Polizas[Cliente etiqueta],ASC)
			RETURN IF(NOT ISBLANK(M) && CONTAINS(C,Polizas[Cliente etiqueta],V),1+COUNTROWS(FILTER(C,[@M]>M || ([@M]=M && Polizas[Cliente etiqueta]<V)))),
			BLANK())
		formatString: 0
		displayFolder: Ajustes finales
		lineageTag: cf2d1467-6bb6-43fc-a025-673ff6f6e806

