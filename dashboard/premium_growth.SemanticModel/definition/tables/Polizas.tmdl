			VAR C=TOPN([Top seleccionado],FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[industry]),"@M",[Polizas YTD]),NOT ISBLANK([@M])),[@M],DESC,Polizas[industry],ASC)
