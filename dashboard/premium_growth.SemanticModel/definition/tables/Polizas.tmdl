			VAR M=[Polizas YTD]
			VAR C=TOPN([Top seleccionado],FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[coverage_type]),"@M",[Polizas YTD]),NOT ISBLANK([@M])),[@M],DESC,Polizas[coverage_type],ASC)
			RETURN IF(NOT ISBLANK(M) && CONTAINS(C,Polizas[coverage_type],V),1+COUNTROWS(FILTER(C,[@M]>M || ([@M]=M && Polizas[coverage_type]<V)))),
			ISINSCOPE(Polizas[Cliente etiqueta]),
