			VAR M=[Polizas YTD]
			VAR C=TOPN([Top seleccionado],FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[Cliente etiqueta]),"@M",[Polizas YTD]),NOT ISBLANK([@M])),[@M],DESC,Polizas[Cliente etiqueta],ASC)
