			RETURN IF(NOT ISBLANK(M) && CONTAINS(C,Polizas[state],V),1+COUNTROWS(FILTER(C,[@M]>M || ([@M]=M && Polizas[state]<V)))),
			ISINSCOPE(Polizas[municipality]),
			VAR V=SELECTEDVALUE(Polizas[municipality])
			VAR M=[Polizas YTD]
			VAR C=TOPN([Top seleccionado],FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[municipality]),"@M",[Polizas YTD]),NOT ISBLANK([@M])),[@M],DESC,Polizas[municipality],ASC)
			RETURN IF(NOT ISBLANK(M) && CONTAINS(C,Polizas[municipality],V),1+COUNTROWS(FILTER(C,[@M]>M || ([@M]=M && Polizas[municipality]<V)))),
			ISINSCOPE(Polizas[coverage_type]),
