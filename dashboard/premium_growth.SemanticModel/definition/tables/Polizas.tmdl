	measure 'Lectura del periodo' =
			VAR Prev = [Prima anterior]
			RETURN IF(ISBLANK(Prev) || Prev = 0, "Sin base anual comparable para este periodo.", "Variacion anual: " & FORMAT([Crecimiento %], "0.0%") & UNICHAR(10) & "Prima anterior: " & FORMAT(Prev, "#,0.00"))
