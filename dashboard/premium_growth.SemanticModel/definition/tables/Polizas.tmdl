		lineageTag: 3a814b82-aa7b-46dd-ac0f-20b258ce2555

	measure 'Elementos YoY' = VAR V=DIVIDE([Elementos YTD]-[Elementos YTD LY],[Elementos YTD LY]) RETURN IF(NOT ISBLANK(V),FORMAT(V,"+0.0%;-0.0%;0.0%") & " vs. LY","Sin base LY")
		formatString: General
		displayFolder: Ajustes finales
		lineageTag: e3755afb-3cce-4a25-a45d-7da9e6b8ed7e

	measure 'KPI comparacion titulo' = IF(SELECTEDVALUE(Metrica[Metrica],"Premium")="Premium","Premium LY YTD","Growth Rate")
		formatString: General
		displayFolder: Ajustes finales
		lineageTag: 7c25283c-a727-448c-ae00-945cf1a7fdbf

	measure 'KPI comparacion' = IF(SELECTEDVALUE(Metrica[Metrica],"Premium")="Premium",[Prima YTD LY]/1000000,[Crecimiento YTD %])
		displayFolder: Ajustes finales
		lineageTag: 981c6581-0c42-4a5b-93d0-3d6d6a0927b9

		formatStringDefinition = IF(SELECTEDVALUE(Metrica[Metrica],"Premium")="Premium","0.0""M""","0.0%;-0.0%;0.0%")

	measure 'Top seleccionado' = SELECTEDVALUE('TopN'[N],5)
		formatString: 0
		displayFolder: Ajustes finales
		lineageTag: 8ff63f98-6ced-445e-8167-1e5980c48feb

	measure 'Ranking visible' = IF(NOT ISBLANK([Ranking]) && [Ranking]<=[Top seleccionado] && NOT ISBLANK([Ranking valor]),1,0)
		formatString: 0
		displayFolder: Ajustes finales
		lineageTag: aba636a6-8bd6-4ed6-913f-ce59c7c5b7fe

	measure 'Polizas ranking visible' = IF(NOT ISBLANK([Ranking polizas]) && [Ranking polizas]<=[Top seleccionado] && NOT ISBLANK([Polizas YTD]),1,0)
		formatString: 0
		displayFolder: Ajustes finales
		lineageTag: 2caa7001-db53-424e-b56d-5013e90d64c5

	measure 'Ranking candidatos' = SWITCH(SELECTEDVALUE(Dimensiones[Orden],0),0,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[industry]),"@M",[Ranking valor]),NOT ISBLANK([@M]))),1,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[state]),"@M",[Ranking valor]),NOT ISBLANK([@M]))),2,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[municipality]),"@M",[Ranking valor]),NOT ISBLANK([@M]))),3,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[coverage_type]),"@M",[Ranking valor]),NOT ISBLANK([@M]))),4,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[Cliente etiqueta]),"@M",[Ranking valor]),NOT ISBLANK([@M]))))
		formatString: 0
		displayFolder: Ajustes finales
		lineageTag: 5612e292-dee5-4419-af00-ecef10de681b

	measure 'Polizas candidatos' = SWITCH(SELECTEDVALUE(Dimensiones[Orden],0),0,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[industry]),"@M",[Polizas YTD]),NOT ISBLANK([@M]))),1,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[state]),"@M",[Polizas YTD]),NOT ISBLANK([@M]))),2,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[municipality]),"@M",[Polizas YTD]),NOT ISBLANK([@M]))),3,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[coverage_type]),"@M",[Polizas YTD]),NOT ISBLANK([@M]))),4,COUNTROWS(FILTER(ADDCOLUMNS(ALLSELECTED(Polizas[Cliente etiqueta]),"@M",[Polizas YTD]),NOT ISBLANK([@M]))))
		formatString: 0
		displayFolder: Ajustes finales
		lineageTag: cfe889c5-39a8-4612-862c-f37eff287b94

	measure 'Ranking alcance' = VAR A=[Ranking candidatos] RETURN "Mostrando " & FORMAT(MIN([Top seleccionado],A),"0") & " de " & FORMAT(A,"0") & " · " & [Elementos titulo]
		formatString: General
		displayFolder: Ajustes finales
		lineageTag: 8c3f8c8e-fe22-491f-b43a-eea683367830

	measure 'Polizas alcance' = VAR A=[Polizas candidatos] RETURN "Mostrando " & FORMAT(MIN([Top seleccionado],A),"0") & " de " & FORMAT(A,"0") & " · " & [Elementos titulo]
		formatString: General
		displayFolder: Ajustes finales
		lineageTag: 1c8b0d51-310e-4622-becf-9f5f691585c2

	measure 'Elementos etiqueta' = [Elementos titulo] & " YTD"
		formatString: General
		displayFolder: Validación y presentación
		lineageTag: ec3fd317-d5c6-444d-9dce-ab03b250193d

	measure 'Color crecimiento' = VAR V=[Crecimiento YTD %] RETURN IF(ISBLANK(V) || V=0,"#53688C",IF(V<0,"#C94454","#009B72"))
		formatString: General
		displayFolder: Validación y presentación
		lineageTag: b430b2e4-b3ef-4e3c-8781-91d3e9e0d760

	measure 'Color elementos' = VAR V=[Elementos YTD]-[Elementos YTD LY] RETURN IF(V=0,"#53688C",IF(V<0,"#C94454","#009B72"))
		formatString: General
		displayFolder: Validación y presentación
		lineageTag: 8615695d-5baf-4147-9c1b-fb2c3e42f4f3

	measure 'Color clientes' = VAR V=[Clientes YTD]-[Clientes YTD LY] RETURN IF(V=0,"#53688C",IF(V<0,"#C94454","#009B72"))
		formatString: General
		displayFolder: Validación y presentación
		lineageTag: 292c2e4c-0cfe-4c27-8eac-defd82d4341a

	measure 'Color polizas' = VAR V=[Polizas YTD]-[Polizas YTD LY] RETURN IF(V=0,"#53688C",IF(V<0,"#C94454","#009B72"))
		formatString: General
		displayFolder: Validación y presentación
		lineageTag: d5d2c5d5-89bd-47d0-83c3-93bfbe1b26b9

	measure 'Color comparacion' = IF(SELECTEDVALUE(Metrica[Metrica],"Premium")="Premium","#0B1747",[Color crecimiento])
		formatString: General
		displayFolder: Validación y presentación
		lineageTag: e8f088a4-7457-4c83-89a8-a214529d339d

